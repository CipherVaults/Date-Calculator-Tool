# Preserve LF line endings for every web/mobile/script file across Windows and Linux
# checkouts so the embedded SHA-256 CSP hashes in mobile/index.html match byte-for-byte.
* text=auto
mobile/*.html text eol=lf
mobile/*.js text eol=lf
mobile/*.webmanifest text eol=lf
ui/*.html text eol=lf
ui/*.css text eol=lf
ui/*.js text eol=lf
scripts/*.mjs text eol=lf
crates/date-core/tests/fixtures/*.json text eol=lf
.github/workflows/*.yml text eol=lf
*.png binary
*.ico binary
*.icns binary
